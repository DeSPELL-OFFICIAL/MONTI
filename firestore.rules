rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // 푸시 토큰만 본인이 갱신한다. 문서 생성·삭제·읽기는 Functions 전용.
    match /devices/{account} {
      allow read, create, delete: if false;
      allow update: if signedIn()
        && request.auth.token.account == account
        && changedOnly(['pushToken']);
    }

    // 사용자가 직접 쓸 수 있는 유일한 네 필드.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, delete: if false;
      allow update: if signedIn()
        && request.auth.uid == uid
        && changedOnly(['nickname', 'locale', 'chatOrder', 'displayName'])
        && (!('locale' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.locale in ['en', 'ko'])
        && (!('nickname' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 24))
        // 티켓에 찍히는 표시 이름. 체인 닉네임(`^[a-z0-9_]{3,20}$`)과는 다른 칸이라 한글이
        // 들어온다 — 글자 종류는 재지 않고 **길이와 제어문자만** 본다. 앞뒤 공백을 지운 뒤
        // 1~24 자여야 한다: 공백만 남은 이름은 티켓에 빈칸을 그리고, 24 자는 티켓 도안이
        // 한 줄에 담을 수 있는 폭이다. 제어문자(개행·NUL)는 SVG 한 줄을 깨뜨리므로 막는다.
        && (!('displayName' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.trim().size() >= 1
                && request.resource.data.displayName.trim().size() <= 24
                && request.resource.data.displayName.matches('^[^\\x00-\\x1f\\x7f]*$')))
        && (!('chatOrder' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.chatOrder is list && request.resource.data.chatOrder.size() <= 200));
    }

    match /eventChats/{eventId} {
      function isChatMember() {
        return signedIn()
          && exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid));
      }
      function chatOpen() {
        return get(/databases/$(database)/documents/eventChats/$(eventId)).data.closed == false;
      }

      allow read: if isChatMember();
      allow write: if false;

      match /members/{uid} {
        allow read: if isChatMember();
        allow write: if false;
      }

      match /messages/{msgId} {
        allow read: if isChatMember();
        // keys().hasOnly 가 `pinned` 를 막는다. 고정은 서버(pinMessage)만 쓴다.
        allow create: if isChatMember()
          && chatOpen()
          && request.resource.data.keys().hasAll(['uid', 'text', 'createdAt', 'reported'])
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt', 'reported'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.reported == 0;
        allow update, delete: if false;
      }
    }

    // 스태프 단말기가 올린 게이트 계정 대기열. 서버 전용이다 — 올리는 길은 `submitPendingGate`,
    // 읽는 길은 `listPendingGates`(체인에서 PERM_MANAGE_GATES 확인) 뿐이다. 아래 포괄 거부가
    // 이미 막지만, 스태프 앱이 쓰는 컬렉션이라 "클라이언트는 여기에 닿지 않는다"를 명시해 둔다.
    match /pendingGates/{gateAccount} {
      allow read, write: if false;
    }

    // 계정 파기 요청 큐. 접수는 `requestAccountDeletion`, 실행은 `processDeletions` 하나씩만 한다.
    // 아래 포괄 거부가 이미 막지만, 여기에 직접 쓸 수 있으면 남의 uid 로 파기를 걸거나
    // 자기 요청의 `scheduledFor` 를 앞당겨 7일 유예를 없앨 수 있다 — 명시해 둔다.
    match /deletionRequests/{uid} {
      allow read, write: if false;
    }

    // 주최사의 표시 이름. 체인에는 이름이 없어서(`Organizers` 는 orgId·오너·권한 비트만 안다)
    // 탐색·공연 화면이 "누가 여는 공연인가"를 그리려면 오프체인에 한 줄이 있어야 한다.
    // 이름은 공개 정보라 로그인한 사람이면 누구나 읽고, 쓰는 길은 서버(`createOrganizerForMe`)
    // 하나다 — 클라이언트가 쓸 수 있으면 남의 주최사 이름을 바꾸거나 없는 주최사를 지어낸다.
    // 소유권·권한의 원본은 여기가 아니라 그대로 체인이다(스펙 §9.4).
    match /orgProfiles/{orgId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 행사 만들기 초안. **클라이언트가 직접 읽고 쓴다** — 2초 디바운스마다 콜러블을 부르면
    // 비용도 지연도 나쁘다(계획 D절). 서버는 이 컬렉션에 닿지 않으므로 `lib/db.ts` 의
    // 허용 목록에도 없다. 초안은 아직 아무것도 아닌 글이라 본인 말고는 누구도 읽지 못한다.
    //
    // 규칙에는 문서 크기를 재는 수단이 없다(`request.resource.size()` 는 없는 함수다).
    // 그래서 칸마다 상한을 건다 — 상한이 없으면 한 사람이 자기 초안 하나로 1 MiB 를 채운다.
    // 포스터는 CID 한 줄로만 들어온다(바이트는 `pinEventImage` 가 IPFS 로 보낸다).
    //
    // 칸 목록을 `hasOnly` 로 잠그지 않는 것은 의도다: 웹의 초안은 화면이 자라면 칸이 늘고,
    // 잠그면 칸 하나가 늘 때마다 저장이 "검증 메시지"가 아니라 **권한 오류**가 된다. 대신
    // 들어온 칸마다 형과 상한을 건다 — 없는 칸은 통과시키고, 있는 칸은 제 모양이어야 한다.
    //
    // **티켓 종류 검사가 여기까지인 이유.** 규칙 엔진은 요청 하나에 표현식 1,000개가 상한이다.
    // 목록을 도는 수단이 없어 8칸을 손으로 펴야 하는데, 칸 하나에 붙이는 검사 값이 그대로
    // 여덟 배가 된다. 에뮬레이터로 재 보면(`test:rules` 가 이 한계를 테스트로 박아 둔다)
    // 8칸에서 감당되는 것은 종류당 검사 **네 개**뿐이다 — `is map`, `name` 상한, `currency`
    // 목록, `art`. 여기에 `supply`/`maxPerWallet` 범위를 하나만 더 붙여도 예산이 터져
    // **6칸부터 저장이 통째로 거부된다**(검증 메시지가 아니라 권한 오류다). 그래서 이 파일이
    // 지키는 것은 "바이트를 담을 수 있는 칸"(문자열)이고, 수의 범위는 화면과 공개 콜러블의
    // 몫으로 남긴다 — 공개는 어차피 체인에 물어보므로 거기가 마지막 문이다.
    match /eventDrafts/{uid}/drafts/{draftId} {
      function mine() {
        return signedIn() && request.auth.uid == uid;
      }
      function capped(field, limit) {
        return !(field in request.resource.data)
          || (request.resource.data[field] is string && request.resource.data[field].size() <= limit);
      }
      function listCapped(field, limit) {
        return !(field in request.resource.data)
          || (request.resource.data[field] is list && request.resource.data[field].size() <= limit);
      }

      // `serverTimestamp()` 는 규칙에 닿기 전에 `request.time` 으로 풀리므로 `is timestamp` 로
      // 재면 된다. 손으로 찍은 숫자 시각은 막는다: 목록이 `orderBy('updatedAt')` 로 "가장 최근
      // 초안"을 고르는데, 숫자를 섞으면 정렬이 두 종류가 되어 이어쓰기가 엉뚱한 초안을 연다.
      function stampOk() {
        return !('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt is timestamp;
      }

      // 공개가 한 번 날아갔다는 표시(`createEvent` 의 userOpHash). 빈 문자열이 "아직 안 보냄"
      // 이고, 보낸 뒤에는 0x + 64 hex 딱 66자다 — 초안이 페이지보다 오래 살아서, 이 칸이
      // 없으면 두 번째 시도가 두 번째 행사가 된다(계획 E절).
      function opHashOk() {
        return !('submittedOpHash' in request.resource.data)
          || (request.resource.data.submittedOpHash is string
              && (request.resource.data.submittedOpHash == ''
                  || request.resource.data.submittedOpHash.matches('^0x[0-9a-fA-F]{64}$')));
      }

      // 티켓 그림은 번들된 프리셋 글자(a~l) 하나이거나 올린 그림의 CID 하나다. 둘 중 무엇이
      // 들어와도 되지만 **그 두 칸 말고는 못 들어온다** — 여기가 잠기지 않으면 그림 칸이
      // base64 바이트를 담는 자리가 된다. 빠진 칸은 통과하는 기본값으로 읽는다.
      //
      // 글자 목록의 원본은 `functions/src/functions/eventArt.ts` 의 `ART_PRESETS` 다. 규칙
      // 파일은 TS 를 읽지 못하므로 두 벌이 존재하고, 어긋나면 `eventArt.test.ts` 가 깨진다.
      //
      // **목록이 아니라 정규식인 이유는 아래 예산이다.** `in ['a',...,'l']` 은 칸마다 글자
      // 수만큼 값을 치러 여덟 칸 × 열두 글자로 1,000개를 넘긴다(넷일 때는 들어갔다). 범위
      // 하나면 칸마다 1이다. 문자열이 아닌 값은 `matches` 가 오류를 내고, 오류는 거부다.
      function artOk(art) {
        let cid = art.get('imageCid', '');
        return art.keys().hasOnly(['preset', 'imageCid'])
          && art.get('preset', 'a').matches('^[a-l]$')
          && cid is string
          && cid.size() <= 80;
      }

      // 티켓 종류 한 줄에서 바이트를 담을 수 있는 칸은 이름과 그림뿐이다. 값(`supply`,
      // `maxPerWallet`, `amount`, `transferCutoffHours`)의 범위는 위 주석의 예산 때문에
      // 여기서 못 잰다 — 수는 8바이트라 문서를 채우지 못하고, 틀린 수는 공개가 막는다.
      function tierOk(tier) {
        return tier is map
          && (!('name' in tier) || (tier.name is string && tier.name.size() <= 40))
          && (!('currency' in tier) || tier.currency in ['free', 'MON', 'USDT', 'USDC'])
          && (!('art' in tier) || artOk(tier.art));
      }

      // 규칙에는 목록을 도는 수단이 없다 — `for` 도 `map` 도 없다. 그래서 상한인 8칸을 편다.
      // `tiers` 와 그 길이를 `let` 으로 한 번만 집는 것이 값을 크게 줄인다(칸마다 다시 집으면
      // 여덟 배가 된다). `n <= i` 가 먼저 참이면 뒤는 평가되지 않으므로, 한 종류짜리 초안은
      // 나머지 일곱 칸 값을 치르지 않는다. 목록이 아닌 값은 위 `listCapped` 가 먼저 막는다.
      function tiersOk() {
        let tiers = request.resource.data.get('tiers', []);
        let n = tiers.size();
        return (n <= 0 || tierOk(tiers[0]))
          && (n <= 1 || tierOk(tiers[1]))
          && (n <= 2 || tierOk(tiers[2]))
          && (n <= 3 || tierOk(tiers[3]))
          && (n <= 4 || tierOk(tiers[4]))
          && (n <= 5 || tierOk(tiers[5]))
          && (n <= 6 || tierOk(tiers[6]))
          && (n <= 7 || tierOk(tiers[7]));
      }

      allow read, delete: if mine();
      allow create, update: if mine()
        && capped('title', 80)
        && capped('body', 5000)
        && capped('description', 5000)
        && capped('posterCid', 80)
        && listCapped('tags', 5)
        && listCapped('tiers', 8)
        && stampOk()
        && opHashOk()
        && tiersOk();
    }

    // 공연의 티켓 그림. 체인의 `Tier` 에 그림 칸이 없고(`Ticket.sol:40-47`) IPFS JSON 은
    // 공개 뒤 고칠 수 없으므로(`updateEventMeta` 는 Draft 전용) 여기가 유일하게 고칠 수 있는
    // 자리다. 그림은 공개 정보라 로그인한 사람이면 누구나 읽는다 — 티켓 목록은 한 화면에
    // 여러 공연의 그림을 그리므로 콜러블로 감싸면 콜드 스타트가 그대로 빈칸이 된다.
    // 쓰는 길은 서버의 `saveEventArt` 하나다(주최자 판정은 체인에서만 할 수 있다).
    match /eventArt/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 공연의 비공개 장소. 서버 전용이다 — 읽는 길은 `getEventPrivate`, 쓰는 길은
    // `setEventPrivate` 뿐이고 둘 다 체인에 묻는다. 규칙만으로는 이 문을 지킬 수 없다:
    // 규칙 파일은 체인을 읽지 못하므로 "티켓을 들고 있는가"를 판정할 방법이 없고,
    // `eventChats` 처럼 거울 문서를 두면 양도 뒤 낡은 거울이 남의 장소를 계속 열어 준다.
    match /eventPrivate/{eventId} {
      allow read, write: if false;
    }

    // 사람 한 명의 하루 핀 횟수. 서버(`pinEventImage`)만 읽고 쓴다. 아래 포괄 거부가 이미
    // 막지만, 클라이언트가 여기에 쓸 수 있으면 자기 카운터를 0 으로 되돌려 한도를 없앨 수 있다.
    match /pinQuota/{personId} {
      allow read, write: if false;
    }

    // Didit 웹훅의 `event_id` 중복 방지 장부. 서버(`diditWebhook`)만 쓰고 아무도 읽지 않는다.
    // 아래 포괄 거부가 이미 막지만, 여기에 쓸 수 있으면 아직 오지 않은 event_id 를 미리 찍어
    // 진짜 배달을 "이미 처리됨"으로 삼키게 만들 수 있다 — 명시해 둔다.
    // `expireAt`(Timestamp) 에 TTL 정책을 건다(콘솔/`gcloud firestore fields ttls update`).
    match /diditEvents/{eventId} {
      allow read, write: if false;
    }

    // persons, passkeys, kycSessions, invites, phoneIndex, transferInvites, authChallenges 포함 전부 거부.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
