{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions/.deploy",
      "configDir": "functions",
      "codebase": "v2",
      "runtime": "nodejs22",
      "predeploy": ["pnpm --filter @monti/shared build", "pnpm --filter monti-functions build:deploy"],
      "ignore": ["node_modules", ".git", "*.local", ".gitkeep"]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8089 },
    "functions": { "port": 5001 },
    "storage": { "port": 9199 },
    "pubsub": { "port": 8085 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
