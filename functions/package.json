{
  "name": "monti-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:deploy": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs",
    "test": "vitest run",
    "test:rules": "RULES=1 vitest run",
    "test:int": "firebase emulators:exec --only firestore,auth --project mon-ti \"vitest run --config vitest.int.config.ts\"",
    "deploy": "pnpm build:deploy && firebase deploy --only functions --project dev"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.0",
    "@google-cloud/kms": "^4.5.0",
    "@google-cloud/storage": "^7.14.0",
    "@simplewebauthn/server": "^13.0.0",
    "cbor-x": "^1.6.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@monti/shared": "workspace:*",
    "@types/node": "^22.7.0",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "firebase-functions-test": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
