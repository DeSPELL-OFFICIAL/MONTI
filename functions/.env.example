# Firebase Functions params. `firebase deploy` 가 이 이름들을 그대로 읽는다.
# 시크릿(ATTESTER_PK, PINATA_JWT 등)은 여기 두지 않는다 — Secret Manager 에 있다.
RP_ID=monti.despell.io
RP_NAME=MONTI
# 안드로이드 앱의 서명 인증서 해시. 앱마다 인증서가 다르므로 **쉼표로 구분한 목록**을 받고,
# 적힌 순서대로 `android:apk-key-hash:<해시>` origin 을 하나씩 만든다.
# 값은 서명 인증서의 SHA-256 을 base64url 로 쓴 것 — 패딩 없이 정확히 43글자다.
# (`keytool` 이 뱉는 `AB:CD:…` 16진수를 그대로 붙여 넣으면 서버가 거부한다.)
# 예(참석자 app.monti, 스태프 app.monti.staff 순): ANDROID_APK_KEY_HASH=<해시1>,<해시2>
ANDROID_APK_KEY_HASH=
# 로컬 개발에서만 채운다(쉼표 구분). 운영 배포는 반드시 비워 둔다 — 여기 적힌 origin 은 패스키를 통과한다.
# 예: DEV_ORIGINS=http://localhost:5173
DEV_ORIGINS=
# 가입 방식. phone(기본) = 전화번호 인증 + 패스키. open = Firebase 익명 로그인만으로 가입하고
# 계정 주소를 기기 키에서 계산한다(패스키 없음). open 은 Firebase 콘솔에서 Anonymous 공급자가 켜져 있어야 한다.
# open 이 아닌 값은 전부 phone 으로 읽는다.
AUTH_MODE=phone
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
ENVIO_GRAPHQL_URL=http://127.0.0.1:8080/v1/graphql
EXPORT_BUCKET=monti-exports
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
BIGQUERY_DATASET=monti
# 릴레이어 EOA 잔액 경보 임계치(MON). relayerHealth 가 이 값 아래에서 system/alerts 에 경보를 남긴다.
# 시크릿 RELAYER_PK 는 여기 두지 않는다 — Secret Manager 에 있다.
RELAYER_LOW_BALANCE_MON=3
