<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The gate app is the one build that cannot work without HCE, so it is the one manifest that
      says so. @monti/hce-android declares the same feature with required="false" because that
      library manifest also merges into the attendee build, where a phone with no HCE is fine;
      the manifest merger ORs android:required, so this line is what decides the staff APK.
      Play then keeps the staff app off phones that could never open a door.
    -->
    <uses-feature
        android:name="android.hardware.nfc.hce"
        android:required="true" />

    <!--
      The QR fallback (staff/qr/scan.ts) reads the attendee's MONTI1: code with the camera when
      their phone cannot write a tag. Declaring CAMERA below makes Google Play assume both
      features are *required* unless they are declared otherwise, and they are not: a gate phone
      whose camera is broken can still take taps, which is the job. HCE above is the requirement;
      this is the fallback.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!--
          What @capgo/capacitor-passkey's sync hook writes for you — except that the hook looks
          only in "android/" and this project lives in "android-staff" (configure-native.js:124,
          it ignores capacitor.config android.path), so it prints "Skipping Android
          auto-configuration" and writes nothing. The wiring is kept in the tree instead, and
          androidProject.test.ts pins it against the origin in capacitor.staff.config.ts so the
          two cannot drift.
        -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/capacitor_passkey_asset_statements" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Without this line Capacitor reports the camera as never-granted and
      @capacitor-mlkit/barcode-scanning's requestPermissions() skips the prompt entirely
      (isPermissionDeclared(CAMERA) in BarcodeScannerPlugin.java) — the QR fallback would
      refuse itself forever on a phone whose camera works. staff/qr/nativeWiring.test.ts pins it.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
</manifest>
