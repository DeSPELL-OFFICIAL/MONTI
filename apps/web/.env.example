VITE_CHAIN_ID=10143
VITE_RPC_URLS=https://monad-testnet.g.alchemy.com/v2/KEY,https://monad.gateway.tenderly.co/KEY,https://testnet-rpc.monad.xyz
VITE_WS_URL=wss://testnet-rpc.monad.xyz
VITE_ADDR_IDENTITY=0x10Fa9977363c40240381BEEfFc2D997BC9Edcd6b
VITE_ADDR_ORGANIZERS=0xAF80CbfDD08284E3aae67FFaaf20A27E281C360A
VITE_ADDR_TICKET=0x7E1fdfCB3688C5b0539101cEAE6a7Ee5bD9b51Cf
VITE_ADDR_FORWARDER=0xb19c37374f9aAf8b0A0a4499080369E93AFB4B5F
# Programmable-settlement layer (a standalone contract deployed after the core four).
# SettlementVault holds per-ticket USDC escrow; VITE_ADDR_USDC is the escrowed token (6 decimals).
# settlementEnabled() needs BOTH present — leave both blank to hide the feature.
VITE_ADDR_SETTLEMENT_VAULT=0xA84FDb64C9DDc3B25eF8BDeA58561BDbE53ABD69
VITE_ADDR_USDC=0x534b2f3A21130d7a60830c2Df862319e593943A3
# The hosted Envio (HyperIndex) indexer. `REPLACE_WITH_INDEXER_ID` is the deployment id Envio
# Cloud hands out. Both tier hosts are in the CSP — the free development tier below and the
# paid `indexer.hyperindex.xyz` — so moving between them is a change to this value alone.
VITE_ENVIO_URL=https://indexer.dev.hyperindex.xyz/REPLACE_WITH_INDEXER_ID/v1/graphql
# The passkey relying party: the exact host the attendee app is served from.
VITE_RP_ID=monti.despell.io
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=monti-dev
VITE_FIREBASE_STORAGE_BUCKET=monti-dev.firebasestorage.app
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
# Where sub-plan 02 deploys the callables.
VITE_FUNCTIONS_REGION=us-east1
# 1 points every Firebase SDK at the local emulators (firebase.json ports).
VITE_USE_EMULATORS=
