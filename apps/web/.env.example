VITE_CHAIN_ID=10143
VITE_RPC_URLS=https://monad-testnet.g.alchemy.com/v2/KEY,https://monad.gateway.tenderly.co/KEY,https://testnet-rpc.monad.xyz
VITE_WS_URL=wss://testnet-rpc.monad.xyz
# v2 (transaction diet) contracts: the rc1 deployment's addresses, copied from
# packages/shared/src/deployments/10143.json once it is published (plan O2/K3). All five are
# redeployed together in v2; USDC and the platform wallet below stay the same as v1.
VITE_ADDR_IDENTITY=REPLACE_WITH_RC1_IDENTITY
VITE_ADDR_ORGANIZERS=REPLACE_WITH_RC1_ORGANIZERS
VITE_ADDR_TICKET=REPLACE_WITH_RC1_TICKET
VITE_ADDR_FORWARDER=REPLACE_WITH_RC1_FORWARDER
# Programmable-settlement layer. SettlementVault holds per-ticket USDC escrow and, in v2, takes
# the one-step purchase; VITE_ADDR_USDC is the escrowed token (6 decimals).
# settlementEnabled() needs BOTH present — leave both blank to hide the feature.
VITE_ADDR_SETTLEMENT_VAULT=REPLACE_WITH_RC1_SETTLEMENT_VAULT
VITE_ADDR_USDC=0x534b2f3A21130d7a60830c2Df862319e593943A3
# The MONTI platform fee wallet — the `platform`-tagged row in every event's split policy (the
# vault's treasury/depositor, which receives the platform's 5% on admission).
VITE_ADDR_PLATFORM=0xAe6D18fA7dC1e2512a2dC7DaE1d4640D7D786Bb2
# The hosted Envio (HyperIndex) indexer. `REPLACE_WITH_INDEXER_ID` is the deployment id Envio
# Cloud hands out — for v2, the id of the v2 indexer deployment (plan O6), not v1's. Both tier hosts are in the CSP — the free development tier below and the
# paid `indexer.hyperindex.xyz` — so moving between them is a change to this value alone.
VITE_ENVIO_URL=https://indexer.dev.hyperindex.xyz/REPLACE_WITH_INDEXER_ID/v1/graphql
# The passkey relying party: the exact host the attendee app is served from.
VITE_RP_ID=monti.despell.io
VITE_IPFS_GATEWAY=https://olive-high-octopus-713.mypinata.cloud/ipfs/
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=monti-dev
VITE_FIREBASE_STORAGE_BUCKET=monti-dev.firebasestorage.app
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
# Where the callables are deployed. us-east4 is the v2 value (codebase v2, deployed beside v1,
# which stays in us-east1 until the cut-over). The SDK calls
# https://<region>-<project>.cloudfunctions.net, which the CSP's *.cloudfunctions.net covers.
VITE_FUNCTIONS_REGION=us-east4
# How a visitor gets an identity: `open` = one tap on /start (anonymous Firebase user + a device
# key on this browser, no phone or passkey); anything else (default) = phone + passkey signup.
VITE_AUTH_MODE=
# 1 points every Firebase SDK at the local emulators (firebase.json ports).
VITE_USE_EMULATORS=
