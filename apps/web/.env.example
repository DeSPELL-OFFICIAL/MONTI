VITE_FIREBASE_APP_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
# Where sub-plan 02 deploys the callables.
VITE_FUNCTIONS_REGION=us-east1
